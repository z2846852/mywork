<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- User-controlled installation of the signed APK reconstructed on device. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Explicit user-granted Usage Access special permission; no screen recorder. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>
    <!-- vivo Health private-provider diagnostic. Usually signature|privileged;
         not a runtime permission and never requested with a UI permission dialog. -->
    <uses-permission android:name="com.vivo.health.widget.permission"/>
    <queries>
        <package android:name="com.vivo.health"/>
        <provider android:authorities="com.vivo.health.provider"/>
        <!-- Android 11+ visibility for the on-device example-word TTS engine. -->
        <intent><action android:name="android.intent.action.TTS_SERVICE"/></intent>
    </queries>
    <application
        android:label="体迹 · BodyTrace"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <provider
            android:name=".ApkInstallProvider"
            android:authorities="${applicationId}.apkupdate"
            android:exported="false"
            android:grantUriPermissions="true"/>
        <service
            android:name=".SleepRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />
        <service
            android:name=".SleepAnalysisService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing"
            android:stopWithTask="false" />
    </application>
</manifest>
